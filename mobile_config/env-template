# Development Environment Variables
REACT_NATIVE_ENV=development
API_BASE_URL=http://10.0.2.2:5001/api
WEB_BASE_URL=http://localhost:5001

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=greenobasket-mobile.firebaseapp.com
FIREBASE_PROJECT_ID=greenobasket-mobile
FIREBASE_STORAGE_BUCKET=greenobasket-mobile.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id

# App Configuration
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# Analytics
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true

# Features
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true
ENABLE_BARCODE_SCANNER=true
ENABLE_OFFLINE_MODE=true

# Debug Settings
ENABLE_FLIPPER=true
LOG_LEVEL=debug

# Store Configuration
ANDROID_PACKAGE_NAME=com.greenobasket.mobile
IOS_BUNDLE_ID=com.greenobasket.mobile

# Instructions:
# 1. Copy this file to .env in your React Native project root
# 2. Install react-native-config: npm install react-native-config
# 3. Update the values with your actual configuration
# 4. Add .env to .gitignore to keep secrets safe